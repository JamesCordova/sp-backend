# ============================================================
# Credenciales necesarias de Supabase (Project Settings > API / Database)
# ============================================================

# Settings > Database > Connection string > "Transaction pooler" o "Session pooler"
# (usar el rol postgres que entrega Supabase; ese rol tiene BYPASSRLS)
# OJO: el driver debe ser asyncpg -> prefijo postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres.xxxxxxxxxxxx:TU_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Settings > API > JWT Settings > JWT Secret
# Se usa para verificar los tokens que Supabase Auth entrega al frontend.
SUPABASE_JWT_SECRET=tu-jwt-secret

# Settings > API > Project API keys > service_role (secreto, NUNCA en el frontend)
# Sólo se usa si el backend necesita llamar a la Admin API de Supabase Auth
# (por ejemplo: revocar la sesión de un usuario bloqueado). Opcional para el MVP.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Orígenes permitidos para CORS (el frontend que sirve index.html/app.js)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
