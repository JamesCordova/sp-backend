# ============================================================
# Credenciales necesarias de Supabase (Project Settings > API / Database)
# ============================================================

# Settings > Database > Connection string > "Session pooler" (recomendado) o
# "Transaction pooler". NO uses la conexión directa (db.<ref>.supabase.co):
# esa solo resuelve por IPv6 y muchos hosts (Render incluido) no tienen salida
# IPv6, lo que causa "Network is unreachable" en producción aunque funcione
# en tu máquina. El pooler es IPv4. Usa el rol "postgres" que entrega
# Supabase (tiene BYPASSRLS). OJO: el driver debe ser asyncpg ->
# prefijo postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres.xxxxxxxxxxxx:TU_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Settings > API > Project URL
# El backend usa esta URL también para verificar tokens contra
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json (claves públicas, ES256).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Settings > API > Project API keys > service_role (secreto, NUNCA en el frontend)
# Sólo se usa si el backend necesita llamar a la Admin API de Supabase Auth
# (por ejemplo: revocar la sesión de un usuario bloqueado). Opcional para el MVP.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Orígenes permitidos para CORS. "*" acepta cualquier origen (sin cookies,
# la auth va por Bearer token, así que no hay riesgo de CSRF vía CORS).
# Para restringirlo, usa una lista separada por comas:
# CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
CORS_ORIGINS=*
